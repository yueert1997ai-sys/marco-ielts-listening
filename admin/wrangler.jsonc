{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marco-vocabulary-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_OWNER": "yueert1997ai-sys",
    "GITHUB_REPO": "marco-ielts-listening",
    "TRAINING_BASE_URL": "https://yueert1997ai-sys.github.io/marco-ielts-listening"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marco-vocabulary-admin",
      "database_id": "replace-with-cloudflare-d1-id"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
